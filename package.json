{
    "name": "folder-structure-generator",
    "displayName": "Folder Structure Generator",
    "description": "Generates folder and file structure from tree-format text input",
    "version": "1.0.4",
    "publisher": "AbelardoR",
    "icon": "icon/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/AbelardoR/folder-structure-generator"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onCommand:extension.generateStructure"
    ],
    "contributes": {
        "commands": [
            {
                "command": "extension.generateStructure",
                "title": "Generate Folder/File Structure"
            }
        ]
    },
    "galleryBanner": {
        "color": "#FFFFFF",
        "theme": "light"
    },
    "badges": [],
    "preview": true
}